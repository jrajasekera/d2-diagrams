# Grid diagram starter
#
# Thesis: a matrix, not a graph. Grids place cells in reading order and ignore
# connections, so use them for support tables, feature matrices, and status
# boards - never for anything with a flow.
#
# grid-columns / grid-rows set the shape; grid-gap sets the breathing room.

grid-columns: 4
grid-gap: 24

linux: Linux
macos: macOS
windows: Windows
kubernetes: Kubernetes

api: API
worker: Worker
web: Web
cli: CLI

stable: Stable
beta: Beta
planned: Planned
deprecated: Deprecated
