# Common style file intended to be imported with: ...@import-common-style
#
# Teaches the import mechanism at its smallest. styles/ is the same idea, built
# out: a shared vocabulary in semantic-classes.d2 plus one palette per pack.

classes: {
  service: {
    shape: rectangle
    style: {
      fill: "#eef6ff"
      stroke: "#2563eb"
      border-radius: 8
      shadow: true
    }
  }
  datastore: {
    shape: cylinder
    style: {
      fill: "#fff7ed"
      stroke: "#c2410c"
    }
  }
  external: {
    shape: person
    style: {
      fill: "#f8fafc"
      stroke: "#64748b"
    }
  }
}

*.style.font-size: 18
