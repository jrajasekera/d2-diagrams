# Styles, classes, and globs starter
#
# Teaches the mechanism: how classes, globs, and multi-class assignment work.
# For real diagrams, import a pack from styles/ instead of redefining a palette
# here - see templates/system-architecture.d2.

direction: right

classes: {
  service: {
    shape: rectangle
    style: {
      fill: "#eef6ff"
      stroke: "#2563eb"
      border-radius: 8
      shadow: true
    }
  }
  database: {
    shape: cylinder
    style: {
      fill: "#fff7ed"
      stroke: "#c2410c"
    }
  }
  warning: {
    style: {
      fill: "#fef3c7"
      stroke: "#d97706"
    }
  }
}

*.style.font-size: 18

web: Web {class: service}
api: API {class: service}
worker: Worker {class: [service; warning]}
db: PostgreSQL {class: database}

web -> api: REST
api -> db: SQL
api -> worker: job
worker -> db: update
